root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonld,cff}]
indent_size = 2

[justfile]
indent_size = 4

[assets/example/*.csv]
end_of_line = unset
trim_trailing_whitespace = unset
insert_final_newline = unset

[*.snap]
insert_final_newline = unset
