config {
    // Tests live next to the code they test (modules/*/tests, workflows/*/tests) and in tests/
    testsDir "."
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test"
    configFile "tests/nextflow.config"
    libDir "tests/lib"

    // Every test runs with the small example settings; add podman with `--profile +podman`
    profile "test"

    // Changes to these files re-run every test with --changed-since
    triggers 'nextflow.config', 'nf-test.config', 'common.nf', 'conf/**', 'tests/nextflow.config', 'tests/lib/**', 'assets/example/**', 'src/**', 'uv.lock'

    // nf-prov copies main.nf into results/ (RO-Crate); never treat it as code
    ignore "results/**", "results_*/**", "work/**"

    requires (
        "nf-test": "0.9.5"
    )

    plugins {
        load "nft-utils@1.2.1"
    }
}
