nextflow_workflow {

    name "Test PROFILE_DATASET"
    script "../main.nf"
    workflow "PROFILE_DATASET"
    tag "workflows"
    tag "profile_dataset"
    topics "versions"

    test("two datasets") {
        when {
            workflow {
                """
                input[0] = channel.of(
                    record(
                        id: 'compounds',
                        table: file("${projectDir}/assets/example/compounds.csv.gz"),
                        id_column: 'compound_id',
                        target_column: 'active',
                        description: 'Compounds',
                        source: null,
                        license: 'CC0-1.0',
                        keywords: 'qsar',
                        dictionary: file("${projectDir}/assets/example/compounds_dictionary.csv")
                    ),
                    record(
                        id: 'expression',
                        table: file("${projectDir}/assets/example/expression.csv"),
                        id_column: 'sample_id',
                        target_column: 'condition',
                        description: null,
                        source: null,
                        license: null,
                        keywords: null,
                        dictionary: null
                    )
                )
                input[1] = record(export_formats: 'parquet,csv,npz', impute: 'median', max_missing: 0.5, n_components: 2, n_clusters: 3, cv_folds: 3, seed: 42)
                input[2] = record(pipeline: 'test/pipeline', version: '0.0.0', homepage: 'https://example.org/pipeline', data_license: 'CC-BY-4.0', creator_name: "O'Test", creator_orcid: '0000-0002-1825-0097')
                """
            }
        }
        then {
            assert workflow.success
            def results = workflow.out.results.sort { r -> r.id }
            assert results*.id == ['compounds', 'expression']
            assert results.every { r -> r.identifier.startsWith('urn:sha256:') }
            assert snapshot(Fixtures.canonical(results), Fixtures.versions(topics.versions, projectDir)).match()
        }
    }
}
