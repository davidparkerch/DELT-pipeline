/*
 * DELT-pipeline configuration
 */

manifest {
    name = 'davidparkerch/delt-pipeline'
    description = 'Process DNA-Encoded Library Technology data and exports FAIR, analysis-ready datasets.'
    version = '0.1.0'
    homePage = 'https://github.com/davidparkerch/delt-pipeline'
    license = 'Apache-2.0'
    mainScript = 'main.nf'
    defaultBranch = 'main'
    nextflowVersion = '!>=26.10.0'
    contributors = [[
        name: 'David Parker',
        email: 'david.parker@bluewin.ch',
        orcid: 'https://orcid.org/0009-0009-2897-5030',
        contribution: ['author', 'maintainer'],
    ]]
}

// Config-only parameter: where workflow outputs are published.
params {
    outdir = 'results'
}

outputDir = params.outdir
workflow.output.mode = 'copy'

// Data lineage: content-addressed lid:// identifiers for every task and output (see `just lineage-list`).
lineage.enabled = true

includeConfig 'conf/base.config'

// Run provenance reports: Workflow Run RO-Crate, BioCompute Object and an HTML task graph.
plugins {
    id 'nf-prov@1.8.0'
}

prov {
    enabled = true
    directory = '.'
    formats {
        wrroc {
            file = 'ro-crate-metadata.json'
            overwrite = true
            license = 'https://spdx.org/licenses/CC-BY-4.0'
            agent {
                name = 'David Parker'
                orcid = 'https://orcid.org/0009-0009-2897-5030'
            }
        }
        bco {
            file = 'pipeline_info/bco.json'
            overwrite = true
            description_domain {
                keywords = ["nextflow", "bioinformatics", "cheminformatics", "machine-learning", "fair"]
            }
        }
        dag {
            file = 'pipeline_info/dag.html'
            overwrite = true
        }
    }
}

timeline {
    enabled = true
    file = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true
}

report {
    enabled = true
    file = "${params.outdir}/pipeline_info/execution_report.html"
    overwrite = true
}

trace {
    enabled = true
    file = "${params.outdir}/pipeline_info/trace.tsv"
    overwrite = true
}

profiles {
    test {
        includeConfig 'conf/test.config'
    }
    podman {
        includeConfig 'conf/podman.config'
    }
}
