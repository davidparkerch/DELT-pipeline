nextflow_process {

    name "Test EXPORT"
    script "../main.nf"
    process "EXPORT"
    tag "modules"
    tag "export"
    topics "versions"

    setup {
        run("SELECT_SUBLIBRARY") {
            script "../../select_sublibrary/main.nf"
            process {
                """
                input[0] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[1] = files("${projectDir}/assets/example/heldout/*.csv")
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("SUBSET_LIBRARY") {
            script "../../subset_library/main.nf"
            process {
                """
                input[0] = channel.of(record(id: 'mapk14', table: file("${projectDir}/assets/example/mapk14.parquet")))
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = SELECT_SUBLIBRARY.out
                """
            }
        }
        run("SCORE") {
            script "../../score/main.nf"
            process {
                """
                input[0] = SUBSET_LIBRARY.out
                input[1] = SELECT_SUBLIBRARY.out
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
    }

    test("every format that can hold missing values") {
        when {
            process {
                """
                input[0] = SCORE.out.map { r -> r + record(id_column: 'molecule_hash', stem: 'mapk14_hits') }
                input[1] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,arrow,csv,tsv,jsonl,npz')
                """
            }
        }
        then {
            assert process.success
            def names = process.out[0][0].exports.collect { p -> file(p).name }.sort()
            assert names == ['mapk14_hits.arrow', 'mapk14_hits.csv', 'mapk14_hits.jsonl', 'mapk14_hits.npz', 'mapk14_hits.parquet', 'mapk14_hits.tsv']
            assert snapshot(Fixtures.canonical(process.out), Fixtures.versions(topics.versions, projectDir)).match()
        }
    }

    test("unknown format fails") {
        when {
            process {
                """
                input[0] = SCORE.out.map { r -> r + record(id_column: 'molecule_hash', stem: 'mapk14_hits') }
                input[1] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,xlsx')
                """
            }
        }
        then {
            assert process.failed
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = channel.of(record(id: 'x', top: file("${projectDir}/assets/example/mapk14.parquet"), id_column: 'molecule_hash', stem: 'x_hits'))
                input[1] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
