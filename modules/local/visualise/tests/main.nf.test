nextflow_process {

    name "Test VISUALISE"
    script "../main.nf"
    process "VISUALISE"
    tag "modules"
    tag "visualise"
    topics "versions"

    setup {
        run("SELECT_SUBLIBRARY") {
            script "../../select_sublibrary/main.nf"
            process {
                """
                input[0] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[1] = files("${projectDir}/assets/example/heldout/*.csv")
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("SUBSET_LIBRARY") {
            script "../../subset_library/main.nf"
            process {
                """
                input[0] = channel.of(record(id: 'mapk14', table: file("${projectDir}/assets/example/mapk14.parquet")))
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = SELECT_SUBLIBRARY.out
                """
            }
        }
        run("SCORE") {
            script "../../score/main.nf"
            process {
                """
                input[0] = SUBSET_LIBRARY.out
                input[1] = SELECT_SUBLIBRARY.out
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("VALIDATE") {
            script "../../validate/main.nf"
            process {
                """
                input[0] = SCORE.out.map { r -> r + record(target: 'MAPK14-sim', heldout_ondna: file("${projectDir}/assets/example/heldout/mapk14_ondna.csv"), heldout_offdna: null) }
                """
            }
        }
    }

    test("cube and validation") {
        when {
            process {
                """
                input[0] = SCORE.out.join(VALIDATE.out, by: 'id').map { r -> r + record(target: "MAPK14 'sim'") }
                """
            }
        }
        then {
            assert process.success
            def figures = path(process.out[0][0].figures).json
            assert figures.keySet() == ['cube', 'validation'] as Set
            assert figures.cube.layout.title.text.startsWith("MAPK14 'sim'")
            assert snapshot(process.out, Fixtures.versions(topics.versions, projectDir)).match()
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = channel.of(record(id: 'x', target: 'X', top: file("${projectDir}/assets/example/mapk14.parquet"), validation: file("${projectDir}/assets/example/samplesheet.csv")))
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
