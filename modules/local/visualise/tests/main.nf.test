nextflow_process {

    name "Test VISUALISE"
    script "../main.nf"
    process "VISUALISE"
    tag "modules"
    tag "visualise"
    topics "versions"

    setup {
        run("WRANGLE") {
            script "../../wrangle/main.nf"
            process {
                """
                input[0] = channel.of(record(
                    id: 'expression',
                    csv: file("${projectDir}/assets/example/expression.csv"),
                    id_column: 'sample_id',
                    target_column: 'condition'
                ))
                input[1] = record(export_formats: 'parquet,arrow,csv,tsv,jsonl,npz,svmlight', impute: 'median', max_missing: 0.5, n_components: 2, n_clusters: 3, cv_folds: 3, seed: 42)
                """
            }
        }
        run("ANALYSE") {
            script "../../analyse/main.nf"
            process {
                """
                input[0] = WRANGLE.out.map { r -> r + record(id_column: 'sample_id', target_column: 'condition') }
                input[1] = record(export_formats: 'parquet,arrow,csv,tsv,jsonl,npz,svmlight', impute: 'median', max_missing: 0.5, n_components: 2, n_clusters: 3, cv_folds: 3, seed: 42)
                """
            }
        }
    }

    test("figures") {
        when {
            process {
                """
                input[0] = WRANGLE.out
                    .join(ANALYSE.out, by: 'id')
                    .map { r -> r + record(id_column: 'sample_id', target_column: 'condition') }
                """
            }
        }
        then {
            assert process.success
            def figures = path(process.out[0][0].figures).json
            assert figures.keySet() == ['correlation', 'distributions', 'importance', 'pca'] as Set
            assert snapshot(process.out, Fixtures.versions(topics.versions, projectDir)).match()
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                def any = file("${projectDir}/assets/example/expression.csv")
                input[0] = channel.of(record(id: 'x', clean: any, embedding: any, stats: any, id_column: 'sample_id', target_column: null))
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
