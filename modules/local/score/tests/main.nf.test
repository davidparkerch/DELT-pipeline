nextflow_process {

    name "Test SCORE"
    script "../main.nf"
    process "SCORE"
    tag "modules"
    tag "score"
    topics "versions"

    setup {
        run("SELECT_SUBLIBRARY") {
            script "../../select_sublibrary/main.nf"
            process {
                """
                input[0] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[1] = files("${projectDir}/assets/example/heldout/*.csv")
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("SUBSET_LIBRARY") {
            script "../../subset_library/main.nf"
            process {
                """
                input[0] = channel.of(record(id: 'mapk14', table: file("${projectDir}/assets/example/mapk14.parquet")))
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = SELECT_SUBLIBRARY.out
                """
            }
        }
    }

    test("five scores, prior on random building blocks") {
        when {
            process {
                """
                input[0] = SUBSET_LIBRARY.out
                input[1] = SELECT_SUBLIBRARY.out
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        then {
            assert process.success
            def qc = path(process.out[0][0].score_qc).json
            assert qc.prior.fitted_on == 'random BB-A'
            // The planted MAPK14 binder family (A2-B5) or the kinase-shared family (A7-B11) ranks first.
            assert [[2, 5], [7, 11]].contains([qc.top[0].bb_a, qc.top[0].bb_b])
            assert snapshot(process.out, Fixtures.versions(topics.versions, projectDir)).match()
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = channel.of(record(id: 'x', counts: file("${projectDir}/assets/example/mapk14.parquet"), counts_qc: file("${projectDir}/assets/example/samplesheet.csv")))
                input[1] = file("${projectDir}/assets/example/samplesheet.csv")
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
