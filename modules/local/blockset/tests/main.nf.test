nextflow_process {

    name "Test BLOCKSET"
    script "../main.nf"
    process "BLOCKSET"
    tag "modules"
    tag "blockset"
    topics "versions"

    setup {
        run("SELECT_SUBLIBRARY") {
            script "../../select_sublibrary/main.nf"
            process {
                """
                input[0] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[1] = files("${projectDir}/assets/example/heldout/*.csv")
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("SUBSET_LIBRARY") {
            script "../../subset_library/main.nf"
            process {
                """
                input[0] = channel.of(record(id: 'mapk14', table: file("${projectDir}/assets/example/mapk14.parquet")))
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = SELECT_SUBLIBRARY.out
                """
            }
        }
        run("SCORE") {
            script "../../score/main.nf"
            process {
                """
                input[0] = SUBSET_LIBRARY.out
                input[1] = SELECT_SUBLIBRARY.out
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
    }

    test("set enrichment finds the planted families' building blocks") {
        when {
            process {
                """
                input[0] = SCORE.out
                """
            }
        }
        then {
            assert process.success
            def qc = path(process.out[0][0].blockset_qc).json
            assert qc.score == 'poisson_lower'
            assert qc.n_tests == 15 - 7 + 25 + 16  // BB-As outside the sub-library are not tested
            // The B blocks of the MAPK14 family (B5) and the kinase-shared family (B11) lead.
            assert ['b'] == qc.top[0..1]*.position.unique()
            assert qc.top[0..1]*.bb_id.toSet() == [5, 11] as Set
            assert snapshot(process.out, Fixtures.versions(topics.versions, projectDir)).match()
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                def any = file("${projectDir}/assets/example/samplesheet.csv")
                input[0] = channel.of(record(id: 'x', scores: any, top: any))
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
