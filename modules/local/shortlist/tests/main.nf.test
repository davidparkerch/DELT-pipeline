nextflow_process {

    name "Test SHORTLIST"
    script "../main.nf"
    process "SHORTLIST"
    tag "modules"
    tag "shortlist"
    topics "versions"

    setup {
        run("SELECT_SUBLIBRARY") {
            script "../../select_sublibrary/main.nf"
            process {
                """
                input[0] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[1] = files("${projectDir}/assets/example/heldout/*.csv")
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("SUBSET_LIBRARY") {
            script "../../subset_library/main.nf"
            process {
                """
                input[0] = channel.of(
                    record(id: 'mapk14', table: file("${projectDir}/assets/example/mapk14.parquet")),
                    record(id: 'bca', table: file("${projectDir}/assets/example/bca.parquet"))
                )
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = SELECT_SUBLIBRARY.out
                """
            }
        }
        run("SCORE") {
            script "../../score/main.nf"
            process {
                """
                input[0] = SUBSET_LIBRARY.out
                input[1] = SELECT_SUBLIBRARY.out
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("AGGREGATE_SYNTHONS") {
            script "../../aggregate_synthons/main.nf"
            process {
                """
                input[0] = SCORE.out.join(SUBSET_LIBRARY.out, by: 'id')
                input[1] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("TRIAGE") {
            script "../../triage/main.nf"
            process {
                """
                input[0] = SCORE.out.join(SUBSET_LIBRARY.out, by: 'id').join(AGGREGATE_SYNTHONS.out, by: 'id')
                    .flatMap { r -> [r.top, r.scores, r.synthons, r.counts_qc] }.collect()
                input[1] = channel.of('mapk14=target', 'bca=counter').collect()
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
    }

    test("a diverse shortlist of the trusted hits") {
        when {
            process {
                """
                input[0] = TRIAGE.out.map { r -> r.hits }
                input[1] = record(n_picks: 6, similarity: 0.5, max_per_cluster: 2, max_per_disynthon: 3)
                """
            }
        }
        then {
            assert process.success
            def qc = path(process.out[0][0].picks_qc).json
            assert qc.parameters.n_picks == 6
            assert qc.screens.keySet() == ['mapk14'] as Set
            assert qc.screens.mapk14.n_picks <= 6
            assert qc.screens.mapk14.picks.clusters >= qc.screens.mapk14.naive_top.clusters
            assert snapshot(process.out, Fixtures.versions(topics.versions, projectDir)).match()
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = file("${projectDir}/assets/example/samplesheet.csv")
                input[1] = record(n_picks: 6, similarity: 0.5, max_per_cluster: 2, max_per_disynthon: 3)
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
