nextflow_process {

    name "Test ANALYSE"
    script "../main.nf"
    process "ANALYSE"
    tag "modules"
    tag "analyse"
    topics "versions"

    setup {
        run("WRANGLE") {
            script "../../wrangle/main.nf"
            process {
                """
                input[0] = channel.of(record(
                    id: 'expression',
                    csv: file("${projectDir}/assets/example/expression.csv"),
                    id_column: 'sample_id',
                    target_column: 'condition'
                ))
                input[1] = record(export_formats: 'parquet,arrow,csv,tsv,jsonl,npz,svmlight', impute: 'median', max_missing: 0.5, n_components: 2, n_clusters: 3, cv_folds: 3, seed: 42)
                """
            }
        }
    }

    test("classification") {
        when {
            process {
                """
                input[0] = WRANGLE.out.map { r -> r + record(id_column: 'sample_id', target_column: 'condition') }
                input[1] = record(export_formats: 'parquet,arrow,csv,tsv,jsonl,npz,svmlight', impute: 'median', max_missing: 0.5, n_components: 2, n_clusters: 3, cv_folds: 3, seed: 42)
                """
            }
        }
        then {
            assert process.success
            def stats = path(process.out[0][0].stats).json
            assert stats.task == 'classification'
            assert stats.model.metrics.roc_auc.mean > 0.9
            assert snapshot(process.out, Fixtures.versions(topics.versions, projectDir)).match()
        }
    }

    test("without target") {
        when {
            process {
                """
                input[0] = WRANGLE.out.map { r -> r + record(id_column: 'sample_id', target_column: null) }
                input[1] = record(export_formats: 'parquet,arrow,csv,tsv,jsonl,npz,svmlight', impute: 'median', max_missing: 0.5, n_components: 2, n_clusters: 3, cv_folds: 3, seed: 42)
                """
            }
        }
        then {
            assert process.success
            assert path(process.out[0][0].stats).json.model == null
            assert snapshot(process.out).match()
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = channel.of(record(id: 'x', clean: file("${projectDir}/assets/example/expression.csv"), id_column: 'sample_id', target_column: null))
                input[1] = record(export_formats: 'parquet,arrow,csv,tsv,jsonl,npz,svmlight', impute: 'median', max_missing: 0.5, n_components: 2, n_clusters: 3, cv_folds: 3, seed: 42)
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
