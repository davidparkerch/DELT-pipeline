nextflow_process {

    name "Test MODEL"
    script "../main.nf"
    process "MODEL"
    tag "modules"
    tag "model"
    topics "versions"

    setup {
        run("SELECT_SUBLIBRARY") {
            script "../../select_sublibrary/main.nf"
            process {
                """
                input[0] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[1] = files("${projectDir}/assets/example/heldout/*.csv")
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("SUBSET_LIBRARY") {
            script "../../subset_library/main.nf"
            process {
                """
                input[0] = channel.of(record(id: 'mapk14', table: file("${projectDir}/assets/example/mapk14.parquet")))
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = SELECT_SUBLIBRARY.out
                """
            }
        }
        run("SCORE") {
            script "../../score/main.nf"
            process {
                """
                input[0] = SUBSET_LIBRARY.out
                input[1] = SELECT_SUBLIBRARY.out
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
    }

    test("fingerprint model under a random and a disynthon split") {
        when {
            process {
                """
                input[0] = SCORE.out.map { r -> r + record(target: 'MAPK14-sim', heldout_ondna: file("${projectDir}/assets/example/heldout/mapk14_ondna.csv"), heldout_offdna: file("${projectDir}/assets/example/heldout/mapk14_offdna.csv")) }
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        then {
            assert process.success
            def report = path(process.out[0][0].model).json
            assert report.results.size() == 8
            assert report.results*.variant.toSet() == ['counts', 'control_weighted'] as Set
            assert report.results*.split.toSet() == ['random', 'disynthon'] as Set
            assert report.training.disynthon.n_train < report.training.random.n_train
            assert report.published_ml.size() == 0 // the simulated target has no published results
            // Model results are floating point on several threads: their files are checked above, not by md5.
            assert snapshot(Fixtures.versions(topics.versions, projectDir)).match()
        }
    }

    test("no held-out data") {
        when {
            process {
                """
                input[0] = SCORE.out.map { r -> r + record(target: 'BCA', heldout_ondna: null, heldout_offdna: null) }
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        then {
            assert process.success
            assert path(process.out[0][0].model).json.results == []
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                def any = file("${projectDir}/assets/example/samplesheet.csv")
                input[0] = channel.of(record(id: 'x', target: 'X', scores: any, heldout_ondna: null, heldout_offdna: null))
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
