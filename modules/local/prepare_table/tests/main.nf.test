nextflow_process {

    name "Test PREPARE_TABLE"
    script "../main.nf"
    process "PREPARE_TABLE"
    tag "modules"
    topics "versions"
    tag "prepare_table"

    test("gzipped csv") {
        when {
            process {
                """
                input[0] = channel.of(record(id: 'compounds', table: file("${projectDir}/assets/example/compounds.csv.gz")))
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out, Fixtures.versions(topics.versions, projectDir)).match()
        }
    }

    test("csv with CRLF line endings") {
        when {
            process {
                """
                input[0] = channel.of(record(id: 'expression', table: file("${projectDir}/assets/example/expression.csv")))
                """
            }
        }
        then {
            assert process.success
            def csv = path(process.out[0][0].csv)
            assert !csv.text.contains('\r')
            assert snapshot(process.out).match()
        }
    }

    test("binary formats pass through") {
        when {
            process {
                """
                def parquet = file("${workDir}/table.parquet")
                parquet.text = 'PAR1\\r\\n'
                input[0] = channel.of(record(id: 'binary', table: parquet))
                """
            }
        }
        then {
            assert process.success
            assert path(process.out[0][0].csv).text == 'PAR1\r\n'
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = channel.of(record(id: 'compounds', table: file("${projectDir}/assets/example/compounds.csv.gz")))
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
