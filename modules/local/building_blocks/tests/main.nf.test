nextflow_process {

    name "Test BUILDING_BLOCKS"
    script "../main.nf"
    process "BUILDING_BLOCKS"
    tag "modules"
    tag "building_blocks"
    topics "versions"

    setup {
        run("SELECT_SUBLIBRARY") {
            script "../../select_sublibrary/main.nf"
            process {
                """
                input[0] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[1] = files("${projectDir}/assets/example/heldout/*.csv")
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("SUBSET_LIBRARY") {
            script "../../subset_library/main.nf"
            process {
                """
                input[0] = channel.of(
                    record(id: 'mapk14', table: file("${projectDir}/assets/example/mapk14.parquet")),
                    record(id: 'bca', table: file("${projectDir}/assets/example/bca.parquet"))
                )
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = SELECT_SUBLIBRARY.out
                """
            }
        }
    }

    test("RDKit descriptors, shared fragments and pre-selection load") {
        when {
            process {
                """
                input[0] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[1] = SELECT_SUBLIBRARY.out
                input[2] = SUBSET_LIBRARY.out.map { r -> r.counts }.collect()
                """
            }
        }
        then {
            assert process.success
            def qc = path(process.out[0][0].blocks_qc).json
            assert qc.n_blocks == [a: 15, b: 25, c: 16]
            assert qc.n_shared_fragments == 2
            assert qc.load_shared_across_screens
            assert snapshot(process.out, Fixtures.versions(topics.versions, projectDir)).match()
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                def any = file("${projectDir}/assets/example/samplesheet.csv")
                input[0] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[1] = any
                input[2] = channel.of(any).collect()
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
