nextflow_process {

    name "Test EXPLORER"
    script "../main.nf"
    process "EXPLORER"
    tag "modules"
    tag "explorer"
    topics "versions"

    setup {
        run("DELT_SELECTION") {
            script "../../../../workflows/delt_selection/main.nf"
            workflow {
                """
                input[0] = channel.of(
                    record(id: 'mapk14', table: file("${projectDir}/assets/example/mapk14.parquet"), target: 'MAPK14-sim', role: 'target', heldout_ondna: file("${projectDir}/assets/example/heldout/mapk14_ondna.csv"), heldout_offdna: file("${projectDir}/assets/example/heldout/mapk14_offdna.csv"), description: 'Synthetic MAPK14 screen', source: null, license: 'CC0-1.0', keywords: 'DEL;kinase'),
                    record(id: 'bca', table: file("${projectDir}/assets/example/bca.parquet"), target: 'BCA-sim', role: 'counter', heldout_ondna: null, heldout_offdna: null, description: null, source: null, license: 'CC0-1.0', keywords: null)
                )
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = file("${projectDir}/assets/hits_dictionary.csv")
                input[3] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                input[4] = record(pipeline: 'test/pipeline', version: '0.0.0', homepage: 'https://example.org/pipeline', data_license: 'CC-BY-4.0', creator_name: "O'Test", creator_orcid: '0000-0002-1825-0097')
                input[5] = record(n_picks: 6, similarity: 0.5, max_per_cluster: 2, max_per_disynthon: 3)
                """
            }
        }
    }

    test("one page with the hits, blocks and shortlist") {
        when {
            process {
                """
                input[0] = DELT_SELECTION.out.triage.flatMap { t -> [t.hits, t.metadata] }
                    .mix(DELT_SELECTION.out.shortlist.map { s -> s.picks })
                    .mix(DELT_SELECTION.out.blocks.map { b -> b.table })
                    .mix(DELT_SELECTION.out.results.map { r -> r.blockset })
                    .collect()
                input[1] = "An <tested> explorer"
                input[2] = record(pipeline: 'test/pipeline', version: '0.0.0', homepage: 'https://example.org/pipeline', data_license: 'CC-BY-4.0', creator_name: "O'Test", creator_orcid: '0000-0002-1825-0097')
                """
            }
        }
        then {
            assert process.success
            def summary = Fixtures.explorer(process.out[0][0])
            assert summary.title == 'An &lt;tested&gt; explorer'
            assert summary.screens == ['mapk14']
            assert summary.blocksets == ['bca', 'mapk14']
            assert summary.hits > 0 && summary.hits == summary.fingerprints
            assert summary.blocks == 15 + 25 + 16
            assert summary.license == 'https://spdx.org/licenses/CC0-1.0'
            assert summary.plotly
            // The page embeds plotly.js, so a structural summary is snapshotted instead of its md5.
            assert snapshot(summary, Fixtures.versions(topics.versions, projectDir)).match()
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [file("${projectDir}/assets/example/samplesheet.csv")]
                input[1] = 'Stub'
                input[2] = record(pipeline: 'test/pipeline', version: '0.0.0', homepage: 'https://example.org/pipeline', data_license: 'CC-BY-4.0', creator_name: "O'Test", creator_orcid: '0000-0002-1825-0097')
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
