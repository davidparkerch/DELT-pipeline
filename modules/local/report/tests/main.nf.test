nextflow_process {

    name "Test REPORT"
    script "../main.nf"
    process "REPORT"
    tag "modules"
    tag "report"

    setup {
        run("DELT_SELECTION") {
            script "../../../../workflows/delt_selection/main.nf"
            workflow {
                """
                input[0] = channel.of(
                    record(id: 'mapk14', table: file("${projectDir}/assets/example/mapk14.parquet"), target: 'MAPK14-sim', role: 'target', heldout_ondna: file("${projectDir}/assets/example/heldout/mapk14_ondna.csv"), heldout_offdna: file("${projectDir}/assets/example/heldout/mapk14_offdna.csv"), description: 'Synthetic MAPK14 screen', source: null, license: 'CC0-1.0', keywords: 'DEL;kinase'),
                    record(id: 'bca', table: file("${projectDir}/assets/example/bca.parquet"), target: 'BCA-sim', role: 'counter', heldout_ondna: null, heldout_offdna: null, description: null, source: null, license: null, keywords: null)
                )
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = file("${projectDir}/assets/hits_dictionary.csv")
                input[3] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                input[4] = record(pipeline: 'test/pipeline', version: '0.0.0', homepage: 'https://example.org/pipeline', data_license: 'CC-BY-4.0', creator_name: "O'Test", creator_orcid: '0000-0002-1825-0097')
                """
            }
        }
    }

    test("standalone html") {
        when {
            process {
                """
                input[0] = DELT_SELECTION.out.results
                    .flatMap { s -> [s.counts_qc, s.score_qc, s.synthon_qc, s.validation, s.figures, s.metadata] }
                    .mix(DELT_SELECTION.out.triage.map { t -> t.triage_qc })
                    .collect()
                input[1] = file("${projectDir}/tests/data/versions.yml")
                input[2] = "A <tested> report"
                input[3] = record(pipeline: 'test/pipeline', version: '0.0.0', homepage: 'https://example.org/pipeline', data_license: 'CC-BY-4.0', creator_name: "O'Test", creator_orcid: '0000-0002-1825-0097')
                """
            }
        }
        then {
            assert process.success
            def summary = Fixtures.report(process.out[0][0])
            assert summary.title == 'A &lt;tested&gt; report'
            assert summary.offline
            assert summary.panels == ['validation', 'triage', 'software']
            assert path(process.out[0][0]).text.contains('<td>coreutils</td><td>9.7</td>')
            // The HTML embeds plotly.js, so a structural summary is snapshotted instead of its md5.
            assert snapshot(summary).match()
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                input[0] = [file("${projectDir}/tests/data/versions.yml")]
                input[1] = file("${projectDir}/tests/data/versions.yml")
                input[2] = 'Stub'
                input[3] = record(pipeline: 'test/pipeline', version: '0.0.0', homepage: 'https://example.org/pipeline', data_license: 'CC-BY-4.0', creator_name: "O'Test", creator_orcid: '0000-0002-1825-0097')
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
