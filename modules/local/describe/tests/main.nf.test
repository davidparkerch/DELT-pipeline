nextflow_process {

    name "Test DESCRIBE"
    script "../main.nf"
    process "DESCRIBE"
    tag "modules"
    tag "describe"
    topics "versions"

    setup {
        run("SELECT_SUBLIBRARY") {
            script "../../select_sublibrary/main.nf"
            process {
                """
                input[0] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[1] = files("${projectDir}/assets/example/heldout/*.csv")
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("SUBSET_LIBRARY") {
            script "../../subset_library/main.nf"
            process {
                """
                input[0] = channel.of(record(id: 'mapk14', table: file("${projectDir}/assets/example/mapk14.parquet")))
                input[1] = file("${projectDir}/assets/example/synthons", type: 'dir')
                input[2] = SELECT_SUBLIBRARY.out
                """
            }
        }
        run("SCORE") {
            script "../../score/main.nf"
            process {
                """
                input[0] = SUBSET_LIBRARY.out
                input[1] = SELECT_SUBLIBRARY.out
                input[2] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("EXPORT") {
            script "../../export/main.nf"
            process {
                """
                input[0] = SCORE.out
                input[1] = record(n_bb_a: 8, alpha: 0.5, ci_level: 0.95, top_n: 200, seed: 42, export_formats: 'parquet,tsv')
                """
            }
        }
        run("CHECKSUM") {
            script "../../checksum/main.nf"
            process {
                """
                input[0] = EXPORT.out
                """
            }
        }
    }

    test("rich metadata") {
        when {
            process {
                """
                input[0] = SCORE.out
                    .join(EXPORT.out, by: 'id')
                    .join(CHECKSUM.out, by: 'id')
                    .map { r -> r + record(
                        description: "MAPK14's synthetic screen",
                        source: 'doi:10.48550/arXiv.2410.08938',
                        license: 'https://github.com/insitro/kindel/blob/main/LICENSE.md',
                        keywords: 'DEL;kinase'
                    ) }
                input[1] = file("${projectDir}/assets/hits_dictionary.csv")
                input[2] = record(pipeline: 'test/pipeline', version: '0.0.0', homepage: 'https://example.org/pipeline', data_license: 'CC-BY-4.0', creator_name: "O'Test", creator_orcid: '0000-0002-1825-0097')
                """
            }
        }
        then {
            assert process.success
            def result = process.out[0][0]
            def metadata = path(result.metadata).json
            assert result.identifier == metadata['@id']
            assert metadata.description == "MAPK14's synthetic screen"
            assert metadata.creator.name == "O'Test"
            assert metadata.isBasedOn == 'https://doi.org/10.48550/arXiv.2410.08938'
            assert metadata.license == 'https://github.com/insitro/kindel/blob/main/LICENSE.md'
            assert metadata.variableMeasured.find { v -> v.name == 'target_1' }.unitText == 'count'
            assert snapshot(result.identifier, metadata, result.datapackage, Fixtures.versions(topics.versions, projectDir)).match()
        }
    }

    test("defaults") {
        when {
            process {
                """
                input[0] = SCORE.out
                    .join(EXPORT.out, by: 'id')
                    .join(CHECKSUM.out, by: 'id')
                    .map { r -> r + record(description: null, source: null, license: null, keywords: null) }
                input[1] = file("${projectDir}/assets/hits_dictionary.csv")
                input[2] = record(pipeline: 'test/pipeline', version: '0.0.0', homepage: 'https://example.org/pipeline', data_license: 'CC-BY-4.0', creator_name: "O'Test", creator_orcid: '0000-0002-1825-0097')
                """
            }
        }
        then {
            assert process.success
            def metadata = path(process.out[0][0].metadata).json
            assert metadata.license == 'https://spdx.org/licenses/CC-BY-4.0'
            assert !metadata.containsKey('isBasedOn')
            assert snapshot(metadata).match()
        }
    }

    test("stub") {
        options "-stub"
        when {
            process {
                """
                def any = file("${projectDir}/assets/example/samplesheet.csv")
                input[0] = channel.of(record(
                    id: 'x', top: any, exports: [any].toSet(), sha256sums: any,
                    description: null, source: null, license: null, keywords: null
                ))
                input[1] = file("${projectDir}/assets/hits_dictionary.csv")
                input[2] = record(pipeline: 'test/pipeline', version: '0.0.0', homepage: 'https://example.org/pipeline', data_license: 'CC-BY-4.0', creator_name: "O'Test", creator_orcid: '0000-0002-1825-0097')
                """
            }
        }
        then {
            assert process.success
            assert snapshot(process.out).match()
        }
    }
}
