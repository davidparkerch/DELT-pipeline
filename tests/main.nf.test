nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    test("synthetic library") {
        when {
            Fixtures.linkAssets(launchDir, projectDir)
            params {
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success

            // Content checks for files that are excluded from md5 snapshots (see tests/.nftignore)
            def report = Fixtures.report("$outputDir/report.html")
            assert report.title == 'Test report'
            def crate = path("$outputDir/ro-crate-metadata.json").json
            assert crate['@graph'].any { entity -> entity['@id'] == './' }
            assert report.datasets == ['bca', 'ddr1', 'mapk14']
            def index = path("$outputDir/screens.json").json
            assert index*.id.sort() == ['bca', 'ddr1', 'mapk14']
            assert index.every { screen -> screen.identifier.startsWith('urn:sha256:') }
            def triage = path("$outputDir/triage/triage_qc.json").json
            assert triage.screens.keySet() == ['ddr1', 'mapk14'] as Set
            def triageMetadata = path("$outputDir/triage/triage.metadata.jsonld").json
            assert triageMetadata.license == 'https://spdx.org/licenses/CC0-1.0'
            assert triageMetadata.distribution*.name.sort() == ['hits.parquet', 'triage_hits.parquet', 'triage_hits.tsv']
            assert report.panels == ['validation', 'triage', 'software']
            def blocksMetadata = path("$outputDir/blocks/building_blocks.metadata.jsonld").json
            assert blocksMetadata.license == 'https://spdx.org/licenses/CC0-1.0'
            assert blocksMetadata.distribution*.name.sort() == ['blocks.parquet', 'building_blocks.parquet', 'building_blocks.tsv']
            def blocksQc = path("$outputDir/blocks/blocks_qc.json").json
            assert blocksQc.n_blocks.a == 15 && blocksQc.load_shared_across_screens
            assert path("$outputDir/screens/mapk14/mapk14.blockset.parquet").exists()
            def picksMetadata = path("$outputDir/shortlist/shortlist.metadata.jsonld").json
            assert picksMetadata.distribution*.name.sort() == ['picks.parquet', 'shortlist.parquet', 'shortlist.tsv']
            assert path("$outputDir/shortlist/picks_qc.json").json.screens.keySet() == ['ddr1', 'mapk14'] as Set
            def sublibrary = path("$outputDir/sublibrary.json").json
            assert sublibrary.heldout.size() + sublibrary.random.size() == 8

            // stable_paths: every file and folder in the output directory
            def stable_paths = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: Fixtures.CRATE_COPIES)
            // stable_content: md5 of every file with reproducible content
            def stable_content = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
            assertAll(
                { assert snapshot(
                    stable_paths,
                    stable_content,
                    Fixtures.versions("$outputDir/pipeline_info/versions.yml", projectDir),
                    report,
                    Fixtures.json("$outputDir/screens/mapk14/mapk14.metadata.jsonld"),
                    Fixtures.json("$outputDir/screens/bca/bca.metadata.jsonld"),
                    Fixtures.json("$outputDir/triage/triage.metadata.jsonld"),
                    Fixtures.json("$outputDir/blocks/building_blocks.metadata.jsonld"),
                    Fixtures.json("$outputDir/shortlist/shortlist.metadata.jsonld"),
                ).match() }
            )
        }
    }

    test("stub") {
        options "-stub"
        when {
            Fixtures.linkAssets(launchDir, projectDir)
            params {
                outdir = "$outputDir"
            }
        }
        then {
            assert workflow.success
            assert snapshot(getAllFilesFromDir(params.outdir, relative: true, includeDir: true, ignore: Fixtures.CRATE_COPIES)).match()
        }
    }

    test("invalid export format fails") {
        when {
            Fixtures.linkAssets(launchDir, projectDir)
            params {
                outdir = "$outputDir"
                export_formats = 'parquet,xlsx'
            }
        }
        then {
            assert workflow.failed
            assert workflow.trace.failed().size() > 0
            assert workflow.trace.failed().every { task -> task.name.contains('EXPORT') }
        }
    }
}
