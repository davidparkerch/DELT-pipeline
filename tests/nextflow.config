/*
 * Settings for every nf-test run: fixed metadata and single-threaded tasks so snapshots are stable.
 */
params {
    creator_name = 'Test Creator'
    creator_orcid = ''
    data_license = 'CC-BY-4.0'
    report_title = 'Test report'
}

process {
    cpus = 1
    resourceLimits = [cpus: 1, memory: 4.GB, time: 1.h]
}
