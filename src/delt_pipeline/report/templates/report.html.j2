<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="{{ pipeline.name }} {{ pipeline.version }}">
<title>{{ title }}</title>
<style>
:root {
  --bg: #f7f8fa; --surface: #ffffff; --text: #1d2330; --muted: #5c6577; --border: #dde1e8;
  --accent: #2f6fde; --ok: #1f8a4c; --warn: #b26a00; --code: #eef1f6;
}
@media (prefers-color-scheme: dark) {
  :root {
    --bg: #12151b; --surface: #1a1e26; --text: #e6e9ef; --muted: #9aa3b5; --border: #2c3240;
    --accent: #6b9cff; --ok: #4cc38a; --warn: #f0a640; --code: #232836;
  }
}
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font: 15px/1.55 system-ui, -apple-system, "Segoe UI", sans-serif; }
header { background: var(--surface); border-bottom: 1px solid var(--border); padding: 24px 16px; }
header h1 { margin: 0 0 4px; font-size: 1.6rem; }
header p { margin: 0; color: var(--muted); }
main { max-width: 1180px; margin: 0 auto; padding: 16px; }
nav.toc { display: flex; flex-wrap: wrap; gap: 8px; margin: 8px 0 16px; }
nav.toc a { color: var(--accent); background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 2px 12px; text-decoration: none; }
section.dataset, section.panel { background: var(--surface); border: 1px solid var(--border); border-radius: 10px; padding: 16px 20px; margin-bottom: 20px; }
h2 { margin-top: 0; font-size: 1.3rem; }
h3 { font-size: 1.05rem; margin: 20px 0 8px; }
.cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
.card { border: 1px solid var(--border); border-radius: 8px; padding: 10px 12px; }
.card .label { color: var(--muted); font-size: 0.8rem; text-transform: uppercase; letter-spacing: 0.04em; }
.card .value { font-size: 1.3rem; font-weight: 600; }
.figures { display: grid; grid-template-columns: repeat(auto-fit, minmax(420px, 1fr)); gap: 16px; }
.figure { min-height: 380px; border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
.table-wrap { overflow-x: auto; }
table { border-collapse: collapse; width: 100%; font-size: 0.9rem; }
th, td { text-align: left; padding: 6px 10px; border-bottom: 1px solid var(--border); white-space: nowrap; }
th { color: var(--muted); font-weight: 600; }
code { background: var(--code); border-radius: 4px; padding: 1px 5px; font-size: 0.85em; word-break: break-all; white-space: normal; }
.muted { color: var(--muted); }
.badge { display: inline-block; border-radius: 4px; padding: 0 6px; font-size: 0.8rem; border: 1px solid var(--border); }
.badge.ok { color: var(--ok); border-color: var(--ok); }
.badge.warn { color: var(--warn); border-color: var(--warn); }
footer { color: var(--muted); text-align: center; padding: 24px 16px 40px; font-size: 0.85rem; }
@media (max-width: 520px) { .figures { grid-template-columns: 1fr; } }
</style>
</head>
<body>
<header>
  <h1>{{ title }}</h1>
  <p>{{ bundles | length }} DEL selection{{ "" if bundles | length == 1 else "s" }} scored by
    {% if pipeline.homepage %}<a href="{{ pipeline.homepage }}">{{ pipeline.name }}</a>{% else %}{{ pipeline.name }}{% endif %}
    v{{ pipeline.version }}</p>
  <p><a href="explorer.html">Open the DELT Explorer</a>: filter, search and mark the hits and building blocks interactively.</p>
  <p>Data license{{ "s" if bundles | map(attribute="metadata.license") | unique | list | length > 1 }}:
    {% for license in bundles | map(attribute="metadata.license") | unique | sort %}<a href="{{ license }}">{{ license }}</a>{{ ", " if not loop.last }}{% endfor %}.
    Results derived from a dataset carry its license.</p>
</header>
<main>
  <nav class="toc" aria-label="Sections">
    <a href="#validation">Validation</a>
    {% if triage %}<a href="#triage">Triage</a>{% endif %}
    {% for bundle in bundles %}<a href="#ds-{{ bundle.id }}">{{ bundle.id }}</a>{% endfor %}
    <a href="#software">Software</a>
  </nav>

  <section class="panel" id="validation">
    <h2>Validation against measured binding affinity</h2>
    <p class="muted">-Spearman correlation between each enrichment score and the KD of resynthesised compounds
      (higher is better). "Published" is the KinDEL paper's baseline for the same score (Counts, Poisson).
      Held-out compounds absent from a screen had no counts and get the score of an all-zero compound.</p>
    {% set validated = bundles | selectattr("validation") | list %}
    {% if validated %}
    <div class="table-wrap"><table>
      <tr><th>Screen</th><th>Assay</th><th>n</th>{% for row in validated[0].validation[0].scores %}<th>{{ row.label }}</th>{% endfor %}</tr>
      {% for bundle in validated %}{% for result in bundle.validation %}
      <tr><td>{{ bundle.id }}</td><td>{{ result.condition }}-DNA</td><td>{{ result.n_compounds }}</td>
        {% for row in result.scores %}<td>{{ "%.3f" | format(row.spearman) if row.spearman is not none else "–" }}{% if row.published is not none %} <span class="muted">({{ "%.3f" | format(row.published) }})</span>{% endif %}</td>{% endfor %}</tr>
      {% endfor %}{% endfor %}
    </table></div>
    {% else %}
    <p><span class="badge warn">none</span> No screen has held-out KD data.</p>
    {% endif %}
  </section>

  {% if triage %}
  <section class="panel" id="triage">
    <h2>Hit triage</h2>
    <p class="muted">The top compounds of every target screen, in tiers. Tier 1 has counts in at least
      {{ triage.thresholds.min_replicates }} of 3 replicates <em>and</em> a disynthon whose other members are
      enriched (lower bound &gt; {{ triage.thresholds.disynthon_lower }}); tier 2 has one of the two; tier 3 neither.
      <em>Flagged</em> compounds are also enriched in a counter-screen (lower bound &gt; {{ triage.thresholds.counter_lower }})
      or in the bead control over their synthesis load (&gt; {{ triage.thresholds.matrix_lower }}), whatever their support.
      A compound that is a top hit of two targets is reported, not penalised.</p>
    <div class="table-wrap"><table>
      <tr><th>Screen</th><th>Compounds</th><th>Tier 1</th><th>Tier 2</th><th>Tier 3</th><th>Flagged</th>
        <th>Counter-screen binders</th><th>Bead binders</th><th>Shared with another target</th></tr>
      {% for screen, summary in triage.screens.items() %}
      <tr><td>{{ screen }}</td><td>{{ "{:,}".format(summary.n_compounds) }}</td>
        {% for tier in ["1", "2", "3", "flagged"] %}<td>{{ "{:,}".format(summary.tiers[tier]) }}</td>{% endfor %}
        <td>{{ summary.flags.counter_binder }}</td><td>{{ summary.flags.matrix_binder }}</td><td>{{ summary.flags.shared_target }}</td></tr>
      {% endfor %}
    </table></div>
    {% if triage.by_score %}
    <h3>What each score lets through</h3>
    <p class="muted">The same triage applied to the top compounds of every score in turn (as many as each screen's
      hit table). A score without the bead control ranks bead binders highly, and triage flags them.</p>
    <div class="table-wrap"><table>
      <tr><th>Ranked by</th>{% for screen in triage.screens %}<th>{{ screen }}: tier 1</th><th>{{ screen }}: flagged</th>{% endfor %}</tr>
      {% for score, by_screen in triage.by_score.items() %}<tr><td>{{ score_labels.get(score, score) }}</td>
        {% for screen in triage.screens %}<td>{{ "{:,}".format(by_screen[screen]["1"]) }}</td><td>{{ "{:,}".format(by_screen[screen]["flagged"]) }}</td>{% endfor %}</tr>{% endfor %}
    </table></div>
    {% endif %}
    {% for screen, summary in triage.screens.items() %}
    <h3>{{ screen }}: best tier-1 hits</h3>
    {% if summary.top_tier1 %}
    <div class="table-wrap"><table>
      <tr><th>Rank</th><th>Molecule</th><th>A</th><th>B</th><th>C</th><th>Target</th><th>Control</th><th>Poisson LB</th><th>Evidence</th></tr>
      {% for row in summary.top_tier1 %}<tr><td>{{ row.rank }}</td><td><code>{{ row.molecule_hash[:12] }}</code></td><td>{{ row.bb_a }}</td><td>{{ row.bb_b }}</td><td>{{ row.bb_c }}</td>
        <td>{{ row.target_sum }}</td><td>{{ row.control_sum }}</td><td>{{ row.poisson_lower }}</td><td>{{ row.reasons }}</td></tr>{% endfor %}
    </table></div>
    {% else %}
    <p><span class="badge warn">none</span> No tier-1 hits.</p>
    {% endif %}
    {% endfor %}
  </section>
  {% endif %}

  {% for bundle in bundles %}
  {% set counts = bundle.counts_qc %}{% set scored = bundle.score_qc %}{% set meta = bundle.metadata %}
  <section class="dataset" id="ds-{{ bundle.id }}">
    <h2>{{ bundle.id }}</h2>
    <p class="muted">{{ meta.description }}</p>
    <div class="cards">
      <div class="card"><div class="label">Library compounds observed</div><div class="value">{{ "{:,}".format(counts.library.n_compounds) }}</div></div>
      <div class="card"><div class="label">Sub-library compounds</div><div class="value">{{ "{:,}".format(counts.sublibrary.n_compounds) }}</div></div>
      <div class="card"><div class="label">BB-A in sub-library</div><div class="value">{{ counts.sublibrary.n_bb_a }}</div></div>
      <div class="card"><div class="label">Target depth</div><div class="value">{{ "{:,.0f}".format(scored.exposure.target) }}</div></div>
      <div class="card"><div class="label">Control depth</div><div class="value">{{ "{:,.0f}".format(scored.exposure.control) }}</div></div>
      <div class="card"><div class="label">With target counts</div><div class="value">{{ "%.1f%%" | format(100 * scored.fraction_with_target_counts) }}</div></div>
      {% if counts.library.saturation %}
      <div class="card"><div class="label">Target counts per library member</div><div class="value">{{ counts.library.saturation.target.oversampling }}</div></div>
      <div class="card"><div class="label">Library observed in target</div><div class="value">{{ "%.1f%%" | format(100 * counts.library.saturation.target.fraction_observed) }}</div></div>
      {% endif %}
    </div>

    <h3>Noise model</h3>
    <p>Beta prior on the target fraction: a = {{ scored.prior.a }}, b = {{ scored.prior.b }}
      (mean {{ scored.prior.mean }} vs. {{ scored.prior.null_fraction }} expected without enrichment), fitted on
      {{ "{:,}".format(scored.prior.n_compounds) }} compounds ({{ scored.prior.fitted_on }}).
</p>
    <p>Replicate agreement (Pearson correlation of log counts between target replicates). Single compounds have
      too few counts to agree; summed per disynthon, the same data agree closely.</p>
    <div class="table-wrap"><table>
      <tr><th>Level</th>{% for pair in scored.replicate_correlation.compound %}<th>{{ pair }}</th>{% endfor %}</tr>
      {% for level, pairs in scored.replicate_correlation.items() %}<tr><td>{{ level }}</td>{% for value in pairs.values() %}<td>{{ value if value is not none else "–" }}</td>{% endfor %}</tr>{% endfor %}
    </table></div>
    <p>

    <h3>Synthons</h3>
    <p class="muted">Counts pooled per building block (mono) and pair (di), scored like compounds. "Enriched" means
      a Poisson lower bound above 1; replicate r is the mean correlation of log counts between target replicates.</p>
    <div class="table-wrap"><table>
      <tr><th>Level</th><th>Synthons</th><th>Enriched</th><th>Replicate r</th></tr>
      {% for level, summary in bundle.synthon_qc.levels.items() %}<tr><td>{{ level }}</td><td>{{ "{:,}".format(summary.n_synthons) }}</td>
        <td>{{ "{:,}".format(summary.n_enriched) }}</td><td>{{ summary.replicate_correlation if summary.replicate_correlation is not none else "–" }}</td></tr>{% endfor %}
    </table></div>

    <h3>Top compounds</h3>
    <div class="table-wrap"><table>
      <tr><th>Molecule</th><th>A</th><th>B</th><th>C</th><th>Target</th><th>Control</th><th>Load</th><th>Poisson LB</th><th>ER</th><th>EB log2</th><th>z (Faver)</th></tr>
      {% for row in scored.top %}<tr><td><code>{{ row.molecule_hash[:12] }}</code></td><td>{{ row.bb_a }}</td><td>{{ row.bb_b }}</td><td>{{ row.bb_c }}</td>
        <td>{{ row.target_sum }}</td><td>{{ row.control_sum }}</td><td>{{ row.load }}</td><td>{{ row.poisson_lower }}</td><td>{{ row.er }}</td><td>{{ row.eb_log2_ratio }}</td><td>{{ row.z_faver }}</td></tr>{% endfor %}
    </table></div>

    <h3>Figures</h3>
    <div class="figures">
      {% for name in bundle.figures | sort %}<div class="figure" id="fig-{{ bundle.id }}-{{ name }}" role="img" aria-label="{{ name }} plot for {{ bundle.id }}"></div>{% endfor %}
    </div>

    <h3>FAIR summary</h3>
    <div class="table-wrap"><table>
      <tr><th>Identifier</th><td><code>{{ meta["@id"] }}</code></td></tr>
      <tr><th>License</th><td><a href="{{ meta.license }}">{{ meta.license }}</a></td></tr>
      {% if meta.isBasedOn is defined %}<tr><th>Source</th><td><a href="{{ meta.isBasedOn }}">{{ meta.isBasedOn }}</a></td></tr>{% endif %}
      {% if meta.creator is defined %}<tr><th>Creator</th><td>{{ meta.creator.name }}{% if meta.creator["@id"] is defined %} (<a href="{{ meta.creator['@id'] }}">ORCID</a>){% endif %}</td></tr>{% endif %}
      <tr><th>Variables</th><td>{{ meta.variableMeasured | length }} described</td></tr>
    </table></div>
    <div class="table-wrap"><table>
      <tr><th>File</th><th>Format</th><th>Size</th><th>SHA-256</th></tr>
      {% for d in meta.distribution %}<tr><td>{{ d.name }}</td><td>{{ d.encodingFormat[0] }}</td><td>{{ d.contentSize }}</td><td><code>{{ d.sha256 }}</code></td></tr>{% endfor %}
    </table></div>
  </section>
  {% endfor %}

  <section class="panel" id="software">
    <h2>Software</h2>
    <div class="table-wrap"><table>
      <tr><th>Tool</th><th>Version</th></tr>
      {% for tool, version in versions %}<tr><td>{{ tool }}</td><td>{{ version }}</td></tr>{% endfor %}
    </table></div>
    <p class="muted">Run provenance: <code>ro-crate-metadata.json</code> (Workflow Run RO-Crate),
      <code>pipeline_info/bco.json</code> (BioCompute Object) and <code>nextflow lineage</code>.</p>
  </section>
</main>
<footer>Generated by {{ pipeline.name }} v{{ pipeline.version }}. Self-contained report: no network access needed.</footer>
<script>{{ plotly_js | safe }}</script>
<script>
const FIGURES = {{ figures | tojson }};
const dark = window.matchMedia("(prefers-color-scheme: dark)").matches;
for (const [id, figure] of Object.entries(FIGURES)) {
  const layout = Object.assign({}, figure.layout, {autosize: true});
  if (dark) {
    Object.assign(layout, {paper_bgcolor: "#1a1e26", plot_bgcolor: "#1a1e26", font: {color: "#e6e9ef"}});
  }
  Plotly.newPlot(id, figure.data, layout, {responsive: true, displaylogo: false});
}
</script>
</body>
</html>
