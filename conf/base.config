/*
 * Default resources. Labels group processes by size; override per process with withName.
 */
process {
    cpus = 1
    memory = 2.GB
    time = 1.h
    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries = 1
    // Fits the development machine: WSL with 16 GB RAM (raise on bigger machines or clusters).
    resourceLimits = [cpus: 16, memory: 12.GB, time: 24.h]

    withLabel: process_single {
        cpus = 1
        memory = 2.GB
    }
    withLabel: process_low {
        cpus = 2
        memory = 4.GB
    }
    withLabel: process_medium {
        cpus = 4
        memory = 8.GB
    }
    // Streams a full KinDEL screen (68 M compounds, ~7 GB of Parquet) into the sub-library table.
    withLabel: process_high {
        cpus = 8
        memory = 10.GB
        time = 4.h
    }
}
