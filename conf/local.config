/*
 * One workstation, e.g. the full KinDEL run: just run-kindel
 *
 * Sized for WSL with 16 GB RAM (15 GB visible to Linux). Tasks may use 12 GB in total; the rest is
 * left for the OS, Podman and the Nextflow JVM (capped by NXF_OPTS in the justfile). The local
 * executor queues tasks against these totals, like a scheduler that knows the machine's real
 * capacity: one full-screen subset (process_high, 10 GB) runs at a time, and Podman's --memory
 * limit kills a task that exceeds its request instead of letting it take the machine down.
 */
executor {
    name = 'local'
    cpus = 16
    memory = 12.GB
}

process.resourceLimits = [cpus: 16, memory: 12.GB, time: 24.h]
