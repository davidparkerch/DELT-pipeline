/*
 * Small run on the bundled synthetic library: nextflow run . -profile test
 * (launch from the project root; samplesheet paths are relative to it).
 */
params {
    input = "${projectDir}/assets/example/samplesheet.csv"
    synthons = "${projectDir}/assets/example/synthons"
    n_bb_a = 8
    top_n = 200
}

process.resourceLimits = [cpus: 2, memory: 4.GB, time: 1.h]
